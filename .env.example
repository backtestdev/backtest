# OpenAI API key for natural language strategy parsing
# Get one at https://platform.openai.com/api-keys
# Optional: the app will use rule-based parsing as fallback if not set
OPENAI_API_KEY=sk-your-key-here

# Clerk authentication
# Get these at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Database (optional - falls back to file-based storage)
# Get a connection string at https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
