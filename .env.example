# OpenAI API key for natural language strategy parsing
# Get one at https://platform.openai.com/api-keys
# Optional: the app will use rule-based parsing as fallback if not set
OPENAI_API_KEY=sk-your-key-here

# Financial Modeling Prep API key for stock data
# Get one at https://financialmodelingprep.com/developer/docs/
# Free tier available (250 requests/day) - Starter tier recommended for production ($14/mo, 750 requests/day)
# Optional: falls back to hardcoded stock database (~100 stocks) if not set
# With API key: 500-2000+ stocks from NYSE/NASDAQ with live financial metrics
FINANCIAL_MODELING_PREP_API_KEY=your-fmp-api-key-here
# Legacy alias (FINANCIAL_MODELING_PREP_API_KEY takes precedence if both set)
# FMP_API_KEY=your-fmp-api-key-here

# Clerk authentication
# Get these at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Database (optional - falls back to file-based storage)
# Get a connection string at https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
